---
// R-006 P3 (§3.7G / v2 §6.1b): evidence-flow strip — decision in, five checks
// along a timeline, evidence out. One accent (#0f6e56) + two neutrals
// (#526b78 line/labels, #d6dee1 nodes). Static, decorative: adjacent prose
// carries the meaning.
const { class: className = 'w-full max-w-[720px]' } = Astro.props;
---
<svg class={className} viewBox="0 0 720 160" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Diagram: a decision enters on the left, passes five verification checks along a timeline, and leaves as evidence on the right">
  <!-- baseline -->
  <line x1="64" y1="70" x2="656" y2="70" stroke="#526b78" stroke-width="1.5" opacity="0.5" />
  <!-- decision-in node -->
  <rect x="16" y="52" width="36" height="36" rx="6" stroke="#526b78" stroke-width="1.5" fill="none" />
  <line x1="26" y1="70" x2="42" y2="70" stroke="#526b78" stroke-width="1.5" stroke-linecap="round" />
  <line x1="34" y1="62" x2="34" y2="78" stroke="#526b78" stroke-width="1.5" stroke-linecap="round" />
  <!-- five check stops -->
  <g stroke="#0f6e56" stroke-width="1.5" fill="#f7f9fa">
    <circle cx="144" cy="70" r="11" />
    <circle cx="252" cy="70" r="11" />
    <circle cx="360" cy="70" r="11" />
    <circle cx="468" cy="70" r="11" />
    <circle cx="576" cy="70" r="11" />
  </g>
  <g stroke="#0f6e56" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none">
    <path d="M139 70 l3.5 3.5 L150 65" />
    <path d="M247 70 l3.5 3.5 L258 65" />
    <path d="M355 70 l3.5 3.5 L366 65" />
    <path d="M463 70 l3.5 3.5 L474 65" />
    <path d="M571 70 l3.5 3.5 L582 65" />
  </g>
  <!-- evidence-out node (document with tick) -->
  <path d="M668 50 h20 l12 12 v28 a2 2 0 0 1 -2 2 h-30 a2 2 0 0 1 -2 -2 v-38 a2 2 0 0 1 2 -2 z" stroke="#526b78" stroke-width="1.5" fill="none" />
  <path d="M688 50 v12 h12" stroke="#526b78" stroke-width="1.5" fill="none" />
  <path d="M676 76 l5 5 l10 -11" stroke="#0f6e56" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none" />
  <!-- labels (end labels edge-anchored: middle-anchoring them at the node
       centres pushed ~5px of glyph past the 0/720 viewBox edges) -->
  <g font-family="'IBM Plex Mono', ui-monospace, monospace" font-size="11" letter-spacing="0.08em" fill="#526b78">
    <text x="16" y="112" text-anchor="start">DECISION IN</text>
    <text x="360" y="112" text-anchor="middle">CONTINUOUS CHECKS</text>
    <text x="704" y="112" text-anchor="end">EVIDENCE OUT</text>
  </g>
  <line x1="104" y1="136" x2="616" y2="136" stroke="#d6dee1" stroke-width="2" stroke-linecap="round" />
</svg>
