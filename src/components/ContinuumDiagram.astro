---
const { class: className = 'h-[240px] w-[240px]' } = Astro.props;
---
<svg class={className} viewBox="-6 -6 172 172" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  <!-- Four stage arcs: 78° each, 12° gaps centred on the cardinals. -->
  <path d="M 119.78 75.82 A 40 40 0 0 0 84.18 40.22" stroke="#0f6e56" stroke-width="3" stroke-linecap="round" fill="none" />
  <path d="M 84.18 119.78 A 40 40 0 0 0 119.78 84.18" stroke="#0f6e56" stroke-width="3" stroke-linecap="round" fill="none" opacity="0.55" />
  <path d="M 40.22 84.18 A 40 40 0 0 0 75.82 119.78" stroke="#0f6e56" stroke-width="3" stroke-linecap="round" fill="none" opacity="0.55" />
  <path d="M 75.82 40.22 A 40 40 0 0 0 40.22 75.82" stroke="#0f6e56" stroke-width="3" stroke-linecap="round" fill="none" opacity="0.35" />
  <!-- Three bare stage nodes (SE, SW, NW diagonals); the NE node is the verified tick below. -->
  <circle cx="108.28" cy="108.28" r="3.5" fill="#0f6e56" />
  <circle cx="51.72" cy="108.28" r="3.5" fill="#0f6e56" />
  <circle cx="51.72" cy="51.72" r="3.5" fill="#0f6e56" />
  <!-- Verified checkpoint on the Identify (NE) arc midpoint — filled node then white tick, in that order. -->
  <g transform="translate(108.28 51.72)">
    <circle r="5.5" fill="#0f6e56" />
    <path d="M -3.2 0 l 2.2 2.4 l 4.2 -5" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none" />
  </g>
  <!-- Stage labels at r=60 (widened from the spec's r=52 to clear the N evidence dot). -->
  <g font-family="'IBM Plex Mono', ui-monospace, monospace" font-size="9" letter-spacing="0.08em" opacity="0.8" fill="#334247" text-anchor="middle" dominant-baseline="middle">
    <text x="122.43" y="37.57">IDENTIFY</text>
    <text x="122.43" y="122.43">TEST</text>
    <text x="37.57" y="122.43">PROTOTYPE</text>
    <text x="37.57" y="37.57">MONITOR</text>
  </g>
  <!-- Centre assurance node. -->
  <circle cx="80" cy="80" r="6" stroke="#0f6e56" stroke-width="1.5" fill="#0f6e56" fill-opacity="0.1" />
  <circle cx="80" cy="80" r="2" fill="#0f6e56" />
  <!-- Orbiting evidence dots. -->
  <circle cx="138.00" cy="80.00" r="2.5" fill="#0f6e56" opacity="0.45" />
  <circle cx="80.00" cy="22.00" r="2.5" fill="#0f6e56" opacity="0.55" />
  <circle cx="22.00" cy="80.00" r="2.5" fill="#0f6e56" opacity="0.45" />
  <circle cx="80.00" cy="138.00" r="2.5" fill="#0f6e56" opacity="0.55" />
  <circle cx="134.50" cy="60.16" r="2.5" fill="#0f6e56" opacity="0.45" />
</svg>
