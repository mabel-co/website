---
// R-006 P3 (§3.7G): coverage motif for "What We Are Not" — an honest empty
// state as a design element. Decorative: the adjacent list carries all meaning.
const { class: className = 'w-full max-w-[360px]' } = Astro.props;
---
<svg class={className} viewBox="0 0 360 200" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Coverage ledger in its empty state: no claims made yet">
  <rect x="1" y="1" width="358" height="198" rx="8" stroke="#526b78" stroke-width="1.5" stroke-dasharray="6 6" fill="none" opacity="0.55" />
  <circle cx="180" cy="78" r="28" stroke="#526b78" stroke-width="1.5" opacity="0.6" fill="none" />
  <line x1="180" y1="64" x2="180" y2="92" stroke="#0f6e56" stroke-width="2" stroke-linecap="round" />
  <line x1="166" y1="78" x2="194" y2="78" stroke="#0f6e56" stroke-width="2" stroke-linecap="round" />
  <line x1="96" y1="132" x2="264" y2="132" stroke="#d6dee1" stroke-width="2" stroke-linecap="round" />
  <text x="180" y="164" font-family="'IBM Plex Mono', ui-monospace, monospace" font-size="11" letter-spacing="0.08em" fill="#526b78" text-anchor="middle">NO CLAIMS MADE YET</text>
</svg>
