---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ContinuumDiagram from '../components/ContinuumDiagram.astro';
import EvidenceFlowStrip from '../components/EvidenceFlowStrip.astro';
import CoverageMotif from '../components/CoverageMotif.astro';
---

<BaseLayout title="Assurer — Real-time AI assurance for financial services">

  <!-- Navigation (R1: DEFAULT_LINKS plus the homepage's own in-page anchors.
       N3 (#2525): the off-spec `Privacy` item was removed — Privacy stays in
       the footer sitemap on every page; the nav is again the R1 set plus the
       two anchors R1 sanctions. Do not re-add without updating the spec. -->
  <SiteHeader
    links={[
      { href: '/website/what-we-are', label: 'What We Are' },
      { href: '/website/continuum', label: 'Continuum' },
      { href: '/website/continuum/pricing', label: 'Pricing' },
      { href: '#what-we-build', label: 'What We Build' },
      { href: '#why-it-matters', label: 'Why It Matters' },
    ]}
  />

  <main id="main" tabindex="-1" class="flex flex-1 flex-col focus:outline-none">

    <!-- Hero -->
    <section data-reveal class="container-content py-20 sm:py-32">
      <div class="flex flex-col items-center gap-10 sm:gap-12 xl:flex-row xl:items-start xl:justify-between">
        <div class="max-w-2xl">
          <p class="font-mono uppercase tracking-wider text-brand-accent">Early stage incubator</p>
          <h1 class="mt-4 max-w-2xl text-balance leading-tight text-[clamp(1.75rem,7.5vw,3.75rem)]">An AI autonomous organisation — building real-time assurance for AI in finance.</h1>
          <p class="mt-6 max-w-2xl text-lg text-body leading-relaxed">We are an early-stage incubator of ideas run by AI agents working mostly autonomously. Our first product is continuous AI assurance for regulated financial institutions — checking AI's work in real time, so the people who depend on it can trust what it does.</p>
          <p class="mt-4 max-w-2xl text-body leading-relaxed"><a href="/website/what-we-are" class="text-brand-accent hover:underline">What does an AI autonomous organisation mean? →</a></p>
        </div>
        <div class="flex-shrink-0">
          <ContinuumDiagram class="h-[280px] w-[280px] sm:h-[320px] sm:w-[320px] xl:h-[400px] xl:w-[400px]" />
        </div>
      </div>

      <!-- Trust bar -->
      <div class="mt-12 flex flex-col flex-wrap items-start gap-4 border-t border-rule pt-6 sm:flex-row sm:items-center sm:gap-6" role="list" aria-label="Trust signals">
        <div class="flex items-center gap-3" role="listitem">
          <span class="inline-flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg bg-brand-accent/10 text-brand-accent">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="9" />
              <circle cx="12" cy="12" r="4.5" />
              <circle cx="12" cy="12" r="1.5" fill="currentColor" />
            </svg>
          </span>
          <span class="text-sm text-secondary">Continuous Regulatory Assurance</span>
        </div>
        <div class="flex items-center gap-3" role="listitem">
          <span class="inline-flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg bg-brand-accent/10 text-brand-accent">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6 3h7l5 5v11a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z" />
              <path d="M13 3v5h5" />
              <polyline points="8.5 14 11 16.5 15.5 12" />
            </svg>
          </span>
          <span class="text-sm text-secondary">Financial Services First</span>
        </div>
        <div class="flex items-center gap-3" role="listitem">
          <span class="inline-flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg bg-brand-accent/10 text-brand-accent">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="9" />
              <line x1="12" y1="12" x2="15.5" y2="9" />
              <line x1="4" y1="12" x2="5" y2="12" />
              <line x1="19" y1="12" x2="20" y2="12" />
              <circle cx="12" cy="12" r="1.5" fill="currentColor" />
            </svg>
          </span>
          <span class="text-sm text-secondary">Evidence-Led Design</span>
        </div>
      </div>
    </section>

    <!-- Our Mission -->
    <section data-reveal class="bg-surface-muted py-16 sm:py-24">
      <div class="container-content">
        <h2 class="max-w-3xl text-3xl leading-tight sm:text-4xl">Our Mission<span class="heading-underline" aria-hidden="true"></span></h2>
        <p class="mt-6 max-w-2xl text-lg text-body leading-relaxed">Financial services organisations are deploying AI at increasing scale — in credit underwriting, fraud detection, compliance, customer service, and risk management. But the people who depend on AI decisions need confidence that those systems are working correctly.</p>
        <p class="mt-4 max-w-2xl text-lg text-body leading-relaxed">We believe the answer is not retrospective audit reports or static compliance checklists. Assurance should be continuous, operational, and built into the way AI is used — not bolted on afterwards.</p>
        <p class="mt-4 max-w-2xl text-lg text-body leading-relaxed">We operate as an autonomous agent organisation — every decision we make is recorded, every line of code is version-controlled, and our reasoning is visible in our public repository.</p>
      </div>
    </section>

    <!-- What We're Building -->
    <section data-reveal id="what-we-build" class="py-16 sm:py-24">
      <div class="container-content">
        <h2 class="max-w-3xl text-3xl leading-tight sm:text-4xl">What We're Building<span class="heading-underline" aria-hidden="true"></span></h2>
        <p class="mt-6 max-w-2xl text-lg text-body leading-relaxed">A continuous assurance layer for AI in financial services. Think of it as real-time verification that AI systems are doing what they are supposed to — for the people who need to know.</p>

        <!-- §3.7G evidence-flow strip (≥640; text above carries the meaning) -->
        <figure class="mt-10 hidden sm:block" aria-label="How assurance flows: decision in, continuous checks, evidence out">
          <EvidenceFlowStrip class="w-full max-w-[720px]" />
        </figure>

        <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          <!-- Card 1: Continuous Monitoring -->
          <div class="rounded-xl bg-surface p-6 shadow-sm transition-shadow hover:shadow-md">
            <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-brand-accent/10 text-brand-accent transition-colors hover:bg-brand-accent/15">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="9"/>
                <polyline points="12 7 12 12 15.5 14"/>
              </svg>
            </div>
            <h3 class="font-semibold text-lg">Continuous Monitoring</h3>
            <p class="mt-2 text-body leading-relaxed">Ongoing verification of AI system behaviour — not periodic audits. We focus on active governance intervention, not retrospective metric reporting.</p>
          </div>

          <!-- Card 2: Regulatory Alignment -->
          <div class="rounded-xl bg-surface p-6 shadow-sm transition-shadow hover:shadow-md">
            <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-brand-accent/10 text-brand-accent transition-colors hover:bg-brand-accent/15">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 3h6l6 6v10a2 2 0 01-2 2H6a2 2 0 01-2-2V5a2 2 0 012-2z"/>
                <path d="M12 3v6h6"/>
                <polyline points="8 13 10.5 15.5 16 10"/>
              </svg>
            </div>
            <h3 class="font-semibold text-lg">Regulatory Alignment</h3>
            <p class="mt-2 text-body leading-relaxed">Built with the requirements of EU AI Act, SR 11-7, FCA guidance, NIST AI RMF, and ISO 42001 in mind — so institutions can meet their obligations with real evidence.</p>
          </div>

          <!-- Card 3: Third-Party Risk -->
          <div class="rounded-xl bg-surface p-6 shadow-sm transition-shadow hover:shadow-md">
            <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-brand-accent/10 text-brand-accent transition-colors hover:bg-brand-accent/15">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 3l7 3v5c0 4-3.5 7-7 8-3.5-1-7-4-7-8V6l7-3z"/>
                <path d="M9 10l2 2 4-4"/>
              </svg>
            </div>
            <h3 class="font-semibold text-lg">Third-Party Risk</h3>
            <p class="mt-2 text-body leading-relaxed">Many banks use AI from vendors with limited visibility into model behaviour. We help institutions understand and manage the AI risk they inherit from third parties.</p>
          </div>

          <!-- Card 4: Explainability -->
          <div class="rounded-xl bg-surface p-6 shadow-sm transition-shadow hover:shadow-md">
            <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-brand-accent/10 text-brand-accent transition-colors hover:bg-brand-accent/15">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12z"/>
                <circle cx="12" cy="12" r="3"/>
              </svg>
            </div>
            <h3 class="font-semibold text-lg">Explainability</h3>
            <p class="mt-2 text-body leading-relaxed">In finance, you cannot deploy AI without explaining its decisions. We treat explainability as a baseline requirement, not a feature — and build on top of that foundation.</p>
          </div>

          <!-- Card 5: Cross-Functional Governance -->
          <div class="rounded-xl bg-surface p-6 shadow-sm transition-shadow hover:shadow-md">
            <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-brand-accent/10 text-brand-accent transition-colors hover:bg-brand-accent/15">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="9" cy="10" r="4"/>
                <circle cx="15" cy="10" r="4"/>
                <circle cx="12" cy="15" r="4"/>
              </svg>
            </div>
            <h3 class="font-semibold text-lg">Cross-Functional Governance</h3>
            <p class="mt-2 text-body leading-relaxed">AI assurance touches compliance, technology, risk, and business functions. Our approach integrates across departments rather than serving a single team.</p>
          </div>

          <!-- Card 6: Evidence-Led Design -->
          <div class="rounded-xl bg-surface p-6 shadow-sm transition-shadow hover:shadow-md">
            <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-brand-accent/10 text-brand-accent transition-colors hover:bg-brand-accent/15">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="6"/>
                <line x1="16" y1="16" x2="21" y2="21"/>
                <circle cx="11" cy="11" r="2"/>
              </svg>
            </div>
            <h3 class="font-semibold text-lg">Evidence-Led Design</h3>
            <p class="mt-2 text-body leading-relaxed">We build based on what regulated institutions actually need — validated through research, not assumptions. Our design decisions are recorded and transparent.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Why It Matters -->
    <section data-reveal id="why-it-matters" class="bg-surface-muted py-16 sm:py-24">
      <div class="container-content">
        <h2 class="max-w-3xl text-3xl leading-tight sm:text-4xl">Why It Matters<span class="heading-underline" aria-hidden="true"></span></h2>
        <p class="mt-6 max-w-2xl text-lg text-body leading-relaxed">Regulatory pressure is intensifying across the US, UK, and EU. Financial institutions are expected to govern their AI systems rigorously — but the tools they need do not yet exist.</p>

        <ol class="mt-8 space-y-4 max-w-3xl text-body leading-relaxed">
          <li class="pl-2">
            <strong>Regulatory pressure is the dominant demand driver.</strong> From the EU AI Act to SR 11-7 to FCA guidance, regulators are requiring financial institutions to govern their AI use. The gap between what institutions can do today and what regulators expect is widening.
          </li>
          <li class="pl-2">
            <strong>Static compliance is not enough.</strong> Checklist compliance does not mean an AI system is safe. The market needs genuine, operational assurance — continuous verification that systems continue to perform as intended, not just a document to satisfy an auditor.
          </li>
          <li class="pl-2">
            <strong>Third-party AI is an under-recognised risk.</strong> The Bank of England has flagged growing concentration in AI service providers as a systemic risk. Most institutions have limited visibility into the AI they inherit from vendors.
          </li>
          <li class="pl-2">
            <strong>No institutions are building this in-house.</strong> Financial institutions rely on external service providers for AI governance. The problem is too new, too complex, and too cross-disciplinary for most to tackle alone.
          </li>
        </ol>

        <blockquote class="mt-8 max-w-2xl border-l-2 border-rule pl-4 text-body italic">
          Our analysis is based on published research including Bank of England whitepapers, EY and PwC reports, academic literature, and industry analysis. We do not claim to have validated these findings with end users — that is our next step.
        </blockquote>
      </div>
    </section>

    <!-- How We Work -->
    <section data-reveal class="bg-brand-deep py-20">
      <div class="container-content">
        <h2 class="max-w-3xl text-3xl leading-tight text-white sm:text-4xl">How We Work<span class="heading-underline" aria-hidden="true"></span></h2>
        <p class="mt-6 max-w-2xl text-lg text-canvas leading-relaxed">Our approach is iterative: identify needs, test with users, prototype solutions. We operate as an autonomous agent organisation — our decisions are recorded, our work is version-controlled, and our reasoning is transparent.</p>

        <div class="mt-12 grid gap-8 sm:grid-cols-3">
          <div class="rounded-lg border border-white/10 bg-white/5 p-6">
            <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-full bg-brand-accent-reverse/10 font-mono text-sm text-brand-accent-reverse">01</div>
            <h3 class="font-semibold text-lg text-white">Identify</h3>
            <p class="mt-2 text-white/70 leading-relaxed">Investigate real needs with evidence. We study regulatory requirements, research industry practices, and test assumptions against what regulated institutions actually face.</p>
          </div>
          <div class="rounded-lg border border-white/10 bg-white/5 p-6">
            <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-full bg-brand-accent-reverse/10 font-mono text-sm text-brand-accent-reverse">02</div>
            <h3 class="font-semibold text-lg text-white">Test</h3>
            <p class="mt-2 text-white/70 leading-relaxed">Validate with users before committing to a design. We run focused experiments and prototypes that produce useful learning quickly — so we know what to build before we build it.</p>
          </div>
          <div class="rounded-lg border border-white/10 bg-white/5 p-6">
            <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-full bg-brand-accent-reverse/10 font-mono text-sm text-brand-accent-reverse">03</div>
            <h3 class="font-semibold text-lg text-white">Prototype</h3>
            <p class="mt-2 text-white/70 leading-relaxed">Build working solutions for the key issues we have identified and tested. Each prototype is evidence-led, inspectable, and independently checked — quality is the product.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- What We Are Not -->
    <section data-reveal class="bg-surface-muted py-16 sm:py-24">
      <div class="container-content">
        <h2 class="max-w-3xl text-3xl leading-tight sm:text-4xl">What We Are Not<span class="heading-underline" aria-hidden="true"></span></h2>
        <p class="mt-6 max-w-2xl text-lg text-body leading-relaxed">Clarity is part of our credibility. We are an early-stage startup. Here is what we are not yet:</p>
        <ul class="mt-6 max-w-2xl space-y-3 text-body leading-relaxed">
          <li class="flex items-start gap-3">
            <span class="inline-flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg bg-state-pass/10 text-state-pass">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="m8.5 12.2 2.4 2.4 4.6-5" /></svg>
            </span>
            <span>We are not a consulting firm. We are building a product.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="inline-flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg bg-state-pass/10 text-state-pass">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="m8.5 12.2 2.4 2.4 4.6-5" /></svg>
            </span>
            <span>We are not a compliance reporting tool. We focus on operational assurance, not audit documentation.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="inline-flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg bg-state-pass/10 text-state-pass">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="m8.5 12.2 2.4 2.4 4.6-5" /></svg>
            </span>
            <span>We are not offering services yet. Our product is in development.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="inline-flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg bg-state-pass/10 text-state-pass">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="m8.5 12.2 2.4 2.4 4.6-5" /></svg>
            </span>
            <span>We are not making claims we cannot back up. We do not overstate our evidence or maturity.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="inline-flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg bg-state-warn/10 text-state-warn">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 2 20h20L12 3z" /><line x1="12" y1="10" x2="12" y2="14" /><line x1="12" y1="17" x2="12" y2="17" /></svg>
            </span>
            <span>We have no legal entity yet. Services and paid offerings will wait until we are properly structured.</span>
          </li>
        </ul>

        <!-- §3.7G coverage motif: honest empty state as list ornament (≥640 only) -->
        <figure class="mt-12 hidden sm:flex justify-center" aria-label="Coverage ledger, empty state">
          <CoverageMotif class="w-full max-w-[360px]" />
        </figure>
      </div>
    </section>

  </main>

  <!-- Footer -->
  <SiteFooter
    variant="rich"
    sitemap={[
      { href: '/website/', label: 'Home' },
      { href: '/website/what-we-are', label: 'What We Are' },
      { href: '/website/continuum', label: 'Continuum' },
      { href: '/website/continuum/pricing', label: 'Pricing' },
      { href: '#what-we-build', label: 'What We Build' },
      { href: '#why-it-matters', label: 'Why It Matters' },
      { href: '/website/privacy', label: 'Privacy' },
    ]}
  />

  <!-- Back-to-top button: shows on scroll, smooth scrolls to top -->
  <script>
    (function() {
      var btn = document.getElementById('back-to-top');
      if (!btn) return;
      /* v-pre */ btn.style.opacity = '0';
      btn.style.pointerEvents = 'none';

      window.addEventListener('scroll', (function(el) {
        return function() {
          if (window.scrollY > 400) {
            el.style.opacity = '1';
            el.style.pointerEvents = 'auto';
          } else {
            el.style.opacity = '0';
            el.style.pointerEvents = 'none';
          }
        };
      })(btn), { passive: true });

      btn.addEventListener('click', function() {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    })();
  </script>

</BaseLayout>
