---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ContinuumDiagram from '../../components/ContinuumDiagram.astro';
import EvidenceFlowStrip from '../../components/EvidenceFlowStrip.astro';
---

<BaseLayout title="Continuum — continuous regulatory assurance for AI in finance" description="Continuum maps evidence from AI system deployments to regulatory requirements so financial institutions stay audit-ready — EU AI Act, SR 11-7, FCA guidance, and ISO 42001." canonical="https://www.assurer.ai/continuum">

  <!-- Navigation (R1: inherits DEFAULT_LINKS) -->
  <SiteHeader />

  <main id="main" tabindex="-1" class="flex flex-1 flex-col focus:outline-none">

    <!-- Hero -->
    <section data-reveal class="container-content py-20 sm:py-32">
      <div class="flex flex-col items-center gap-10 xl:flex-row xl:items-start xl:justify-between">
        <div class="max-w-2xl">
          <p class="font-mono uppercase tracking-wider text-brand-accent">Our first product</p>
          <h1 class="mt-4 max-w-3xl text-balance leading-tight text-[clamp(1.75rem,7.5vw,3rem)]">Continuum — continuous regulatory assurance for AI in finance.</h1>
          <p class="mt-6 max-w-2xl text-lg text-body leading-relaxed">Continuum is our platform for keeping financial institutions audit-ready: it continuously maps evidence from AI system deployments to the regulatory requirements that apply to them, so the people responsible for that AI can see what regulators need, when they need it.</p>
          <p class="mt-4 max-w-2xl text-sm text-secondary">Continuum is in development. This page describes the MVP we are building now.</p>
        </div>
        <div class="flex-shrink-0">
          <ContinuumDiagram class="h-[280px] w-[280px] sm:h-[320px] sm:w-[320px] xl:h-[400px] xl:w-[400px]" />
        </div>
      </div>
    </section>

    <!-- What Continuum does -->
    <section data-reveal class="bg-surface-muted py-16 sm:py-24">
      <div class="container-content">
        <h2 class="max-w-3xl text-3xl leading-tight sm:text-4xl">What Continuum does<span class="heading-underline" aria-hidden="true"></span></h2>
        <p class="mt-6 max-w-2xl text-lg text-body leading-relaxed">Existing tools produce one-off reports or periodic assessments, but regulators increasingly require continuous, operational assurance. Continuum keeps institutions in an audit-ready state at all times by continuously collecting evidence from their AI systems and mapping it to the regulations that apply — EU AI Act (high-risk provisions), SR 11-7, FCA guidance, and ISO 42001.</p>
      </div>
    </section>

    <!-- What is in the MVP -->
    <section data-reveal class="py-16 sm:py-24">
      <div class="container-content">
        <h2 class="max-w-3xl text-3xl leading-tight sm:text-4xl">What is in the MVP<span class="heading-underline" aria-hidden="true"></span></h2>

        <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          <!-- Card 1: Regulatory Mapping Engine -->
          <div class="rounded-xl bg-surface p-6 shadow-sm transition-shadow hover:shadow-md">
            <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-brand-accent/10 text-brand-accent transition-colors hover:bg-brand-accent/15">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 20h9"/>
                <path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/>
              </svg>
            </div>
            <h3 class="font-semibold text-lg">Regulatory Mapping Engine</h3>
            <p class="mt-2 text-body leading-relaxed">Rule-based mapping of AI system evidence to EU AI Act (high-risk), SR 11-7, FCA guidance, and ISO 42001 requirements. Every control node is human-validated before it goes live.</p>
          </div>

          <!-- Card 2: Evidence Collection -->
          <div class="rounded-xl bg-surface p-6 shadow-sm transition-shadow hover:shadow-md">
            <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-brand-accent/10 text-brand-accent transition-colors hover:bg-brand-accent/15">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
                <polyline points="17 8 12 3 7 8"/>
                <line x1="12" y1="3" x2="12" y2="15"/>
              </svg>
            </div>
            <h3 class="font-semibold text-lg">Evidence Collection</h3>
            <p class="mt-2 text-body leading-relaxed">Pre-built connectors import evidence from the MRM/GRC tools institutions already use (ServiceNow, OneTrust, SAS Model Manager). Continuum works alongside existing tools, not as a replacement.</p>
          </div>

          <!-- Card 3: Compliance Dashboard -->
          <div class="rounded-xl bg-surface p-6 shadow-sm transition-shadow hover:shadow-md">
            <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-brand-accent/10 text-brand-accent transition-colors hover:bg-brand-accent/15">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2"/>
                <path d="M3 9h18"/>
                <path d="M9 21V9"/>
              </svg>
            </div>
            <h3 class="font-semibold text-lg">Compliance Dashboard</h3>
            <p class="mt-2 text-body leading-relaxed">Audit-readiness status per regulation: covered, partial, or gap — with what evidence is still missing.</p>
          </div>

          <!-- Card 4: Report Generation -->
          <div class="rounded-xl bg-surface p-6 shadow-sm transition-shadow hover:shadow-md">
            <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-brand-accent/10 text-brand-accent transition-colors hover:bg-brand-accent/15">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
                <line x1="16" y1="13" x2="8" y2="13"/>
                <line x1="16" y1="17" x2="8" y2="17"/>
              </svg>
            </div>
            <h3 class="font-semibold text-lg">Report Generation</h3>
            <p class="mt-2 text-body leading-relaxed">Exportable, regulatory-ready audit packages with plain-language narrative explainability, every output carrying provenance back to the source evidence.</p>
          </div>

          <!-- Card 5: Explainability -->
          <div class="rounded-xl bg-surface p-6 shadow-sm transition-shadow hover:shadow-md">
            <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-brand-accent/10 text-brand-accent transition-colors hover:bg-brand-accent/15">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12z"/>
                <circle cx="12" cy="12" r="3"/>
              </svg>
            </div>
            <h3 class="font-semibold text-lg">Explainability</h3>
            <p class="mt-2 text-body leading-relaxed">Translates technical model outputs (SHAP, LIME, feature importance) into narrative reports a governance committee can read.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section data-reveal class="bg-surface-muted py-16 sm:py-24">
      <div class="container-content">
        <h2 class="max-w-3xl text-3xl leading-tight sm:text-4xl">How it works<span class="heading-underline" aria-hidden="true"></span></h2>

        <!-- §3.7G evidence-flow strip: this is Map → Collect → Show drawn as
             decision in, continuous checks, evidence out (≥640; the numbered
             cards below carry the same meaning in text) -->
        <figure class="mt-10 hidden sm:block" aria-label="How Continuum works: a decision enters, passes continuous checks, and leaves as evidence">
          <EvidenceFlowStrip class="w-full max-w-[720px]" />
        </figure>

        <div class="mt-12 grid gap-8 sm:grid-cols-3">
          <div class="rounded-xl bg-surface p-6 shadow-sm transition-shadow hover:shadow-md">
            <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-full bg-brand-accent/10 font-mono text-sm text-brand-accent">01</div>
            <h3 class="font-semibold text-lg">Map</h3>
            <p class="mt-2 text-body leading-relaxed">Continuum maintains a knowledge graph of regulatory requirements, and the controls and evidence types that satisfy them, for each regulation in scope.</p>
          </div>
          <div class="rounded-xl bg-surface p-6 shadow-sm transition-shadow hover:shadow-md">
            <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-full bg-brand-accent/10 font-mono text-sm text-brand-accent">02</div>
            <h3 class="font-semibold text-lg">Collect</h3>
            <p class="mt-2 text-body leading-relaxed">Connectors continuously pull evidence artefacts — model cards, validation reports, monitoring logs, change records — from the MRM/GRC tools an institution already runs.</p>
          </div>
          <div class="rounded-xl bg-surface p-6 shadow-sm transition-shadow hover:shadow-md">
            <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-full bg-brand-accent/10 font-mono text-sm text-brand-accent">03</div>
            <h3 class="font-semibold text-lg">Show</h3>
            <p class="mt-2 text-body leading-relaxed">The dashboard and reports surface audit-readiness status, gaps, and regulatory-ready narratives with provenance to the source evidence.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Who it is for -->
    <section data-reveal class="py-16 sm:py-24">
      <div class="container-content">
        <h2 class="max-w-3xl text-3xl leading-tight sm:text-4xl">Who it is for<span class="heading-underline" aria-hidden="true"></span></h2>
        <p class="mt-6 max-w-2xl text-lg text-body leading-relaxed">The buyer is a cross-functional governance committee, not a single role:</p>

        <ul class="mt-6 max-w-2xl space-y-3 text-body leading-relaxed">
          <li class="flex items-start gap-3"><svg class="mt-1 h-4 w-4 flex-shrink-0 text-brand-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span>Chief risk officers</span></li>
          <li class="flex items-start gap-3"><svg class="mt-1 h-4 w-4 flex-shrink-0 text-brand-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span>Chief compliance officers</span></li>
          <li class="flex items-start gap-3"><svg class="mt-1 h-4 w-4 flex-shrink-0 text-brand-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span>Heads of model risk management</span></li>
          <li class="flex items-start gap-3"><svg class="mt-1 h-4 w-4 flex-shrink-0 text-brand-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span>CISOs</span></li>
          <li class="flex items-start gap-3"><svg class="mt-1 h-4 w-4 flex-shrink-0 text-brand-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span>Internal audit and risk committees</span></li>
        </ul>

        <p class="mt-6 max-w-2xl text-lg text-body leading-relaxed">Target organisations: Tier 1 and Tier 2 financial institutions in the US, UK, and EU with significant AI/ML deployments in credit underwriting, fraud detection, risk assessment, and customer service.</p>
      </div>
    </section>

    <!-- Why now -->
    <section data-reveal class="bg-surface-muted py-16 sm:py-24">
      <div class="container-content">
        <h2 class="max-w-3xl text-3xl leading-tight sm:text-4xl">Why now<span class="heading-underline" aria-hidden="true"></span></h2>

        <ol class="mt-8 max-w-3xl space-y-3 text-body leading-relaxed">
          <li class="flex items-start gap-3"><svg class="mt-1 h-4 w-4 flex-shrink-0 text-brand-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span><strong>EU AI Act enforcement for high-risk systems now begins 2 December 2027</strong> — deferred by Regulation (EU) 2026/1744 (Digital Omnibus on AI).</span></li>
          <li class="flex items-start gap-3"><svg class="mt-1 h-4 w-4 flex-shrink-0 text-brand-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span><strong>SR 11-7 reviews of AI model governance are ongoing.</strong></span></li>
          <li class="flex items-start gap-3"><svg class="mt-1 h-4 w-4 flex-shrink-0 text-brand-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span><strong>Regulators are moving from voluntary guidance to binding requirements</strong> — and static checklists do not demonstrate operational assurance.</span></li>
        </ol>
      </div>
    </section>

    <!-- What Continuum is not yet -->
    <section data-reveal class="py-16 sm:py-24">
      <div class="container-content">
        <h2 class="max-w-3xl text-3xl leading-tight sm:text-4xl">What Continuum is not yet<span class="heading-underline" aria-hidden="true"></span></h2>
        <p class="mt-6 max-w-2xl text-lg text-body leading-relaxed">We are plain about where we are:</p>
        <ul class="mt-6 max-w-2xl space-y-3 text-body leading-relaxed">
          <li class="flex items-start gap-3"><svg class="mt-1 h-4 w-4 flex-shrink-0 text-secondary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/></svg><span>It is not live yet — the MVP is in development.</span></li>
          <li class="flex items-start gap-3"><svg class="mt-1 h-4 w-4 flex-shrink-0 text-secondary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/></svg><span>On-premise/VPC deployment, enterprise SSO, and expanded regulation coverage are planned after the MVP.</span></li>
          <li class="flex items-start gap-3"><svg class="mt-1 h-4 w-4 flex-shrink-0 text-secondary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/></svg><span>Pricing is not final — <a href="/continuum/pricing" class="text-brand-accent hover:underline">see the pricing page</a>.</span></li>
        </ul>
      </div>
    </section>

    <!-- CTA: Stay informed about Continuum (dark band) -->
    <section data-reveal class="bg-brand-deep py-20">
      <div class="container-content">
        <h2 class="max-w-3xl text-3xl leading-tight text-white sm:text-4xl">Stay informed about Continuum<span class="heading-underline" aria-hidden="true"></span></h2>
        <p class="mt-6 max-w-2xl text-lg text-white/80 leading-relaxed">We will share updates as we build — product progress, early access opportunities, and pricing announcements.</p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="/#stay-informed" class="inline-flex items-center justify-center rounded-md bg-brand-accent px-4 py-2 text-sm font-medium text-white hover:opacity-90 transition-opacity">
            Get updates →
          </a>
          <a href="/continuum/pricing" class="inline-flex items-center justify-center rounded-md border border-white/20 bg-white/10 px-4 py-2 text-sm font-medium text-white hover:opacity-90 transition-opacity">
            Pricing
          </a>
        </div>
      </div>
    </section>

  </main>

  <!-- Footer (R2: inherits DEFAULT_SITEMAP, rich) -->
  <SiteFooter />

  <!-- Back-to-top button: shows on scroll, smooth scrolls to top -->
  <script>
    (function() {
      var btn = document.getElementById('back-to-top');
      if (!btn) return;
      /* v-pre */ btn.style.opacity = '0';
      btn.style.pointerEvents = 'none';

      window.addEventListener('scroll', (function(el) {
        return function() {
          if (window.scrollY > 400) {
            el.style.opacity = '1';
            el.style.pointerEvents = 'auto';
          } else {
            el.style.opacity = '0';
            el.style.pointerEvents = 'none';
          }
        };
      })(btn), { passive: true });

      btn.addEventListener('click', function() {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    })();
  </script>

</BaseLayout>